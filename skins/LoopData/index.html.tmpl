#errorCatcher Echo
#encoding UTF-8
<!DOCTYPE html>
## The theme.  auto (the default) leaves the page to the css, where a
## media query follows the viewer's own system setting; dark and light
## pin it, for a station that wants one regardless of who is looking.
## .get, not has_key: the installer writes this option commented, and an
## [Extras] option that is present but empty would still satisfy has_key.
## Anything unrecognized falls back to auto, in keeping with every other
## option here.
#set $theme = str($Extras.get('theme', 'auto')).strip().lower()
#if $theme in ('dark', 'light')
<html lang="$lang" data-theme="$theme">
#else
<html lang="$lang">
#end if
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="favicon.ico">
    #if $Extras.has_key('meta_title')
      <title>$Extras.meta_title</title>
    #else
      <title>$station.location</title>
    #end if
    <meta name="description" content="$gettext('Up to date weather readings for {location}.').format(location=$station.location)">
    <style>
      /* The panel's palette, and the SINGLE source of truth for it: the
         instruments are SVG whose every stroke and fill is a class
         dressed below, so the javascript names no color and a theme is a
         css change and nothing else.

         Two instruments, one per theme.  Dark: a deep well on a navy
         card.  Light: a pale blue-gray face on a white card.  In both, one
         red arm per gauge, as on an analog gauge -- a red each theme can
         carry, so two values; the wind's gust needle is not that arm and
         keeps its own color.  In both, the face stands barely off its
         card, so it is the rim that draws the disc.  --ink, --muted and
         --heading are text on the card; --live alone is text on the
         ground.  The six --rose values are the windrose's speed bands,
         bright on the dark well and dark on the light face, each set
         stepping evenly against its own face.

         THREE STATES, and the order matters.  :root carries dark, so a
         browser that reports nothing still gets the dark page.  The media
         query supplies light for a viewer whose system asks for light --
         unless the page has been pinned to dark.  The [data-theme] rules
         let [Extras] theme pin either one outright.  The light VALUES are
         written once, as --light-*, so the two places that select them
         cannot drift apart in value; a test pins that they select the same
         set. */
      :root {
        /* So the browser's own chrome -- scrollbars, focus rings, form
           controls -- follows the theme rather than staying light. */
        color-scheme: dark;
        --ground: #0a0f22;
        --card: #111834;
        --line: #2a3358;
        --ring: #5b67a0;
        --ink: #e9e4d4;
        --ink-2: #ded9c9;
        --muted: #b2bae1;
        --heading: #99c2dd;
        --hi: #ffa289;
        --lo: #a5b7ff;
        --live: #ffb92e;
        --face: #0b1026;
        --rim: #6a76a7;
        --tick: #6677a3;
        --major: #e9e4d4;
        --letter: #b2bae1;
        --needle: #ef5350;
        --gust: #7985b1;
        --range: #99c2dd;
        --swatch-edge: #b2bae1;
        --rose1: #4778c9;
        --rose2: #4b91e1;
        --rose3: #5dacea;
        --rose4: #77c9f3;
        --rose5: #a4e6fb;
        --rose6: #f5fcfe;
        /* Behind an open card: the page, dimmed.  Written as a color
           with alpha, so the panel still shows through it. */
        --backdrop: rgba(10, 15, 34, 0.6);

        /* The light theme's values.  Named here, applied below. */
        --light-ground: #e3e3e3;
        --light-card: #ffffff;
        --light-line: #999999;
        --light-ring: #7f8995;
        --light-ink: #222222;
        --light-ink-2: #343434;
        --light-muted: #545e69;
        --light-heading: #246a92;
        --light-hi: #aa4444;
        --light-lo: #4444aa;
        --light-live: #815009;
        --light-face: #f3f6f9;
        --light-rim: #5f6b78;
        --light-tick: #6f7a87;
        --light-major: #1b2733;
        --light-letter: #4a5563;
        --light-needle: #c62828;
        --light-gust: #5f7182;
        --light-range: #163e5a;
        --light-swatch-edge: #545e69;
        --light-rose1: #3892c0;
        --light-rose2: #2875ad;
        --light-rose3: #1c5a99;
        --light-rose4: #124183;
        --light-rose5: #092764;
        --light-rose6: #01071a;
        --light-backdrop: rgba(30, 40, 60, 0.45);
      }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) {
          color-scheme: light;
          --ground: var(--light-ground);
          --card: var(--light-card);
          --line: var(--light-line);
          --ring: var(--light-ring);
          --ink: var(--light-ink);
          --ink-2: var(--light-ink-2);
          --muted: var(--light-muted);
          --heading: var(--light-heading);
          --hi: var(--light-hi);
          --lo: var(--light-lo);
          --live: var(--light-live);
          --face: var(--light-face);
          --rim: var(--light-rim);
          --tick: var(--light-tick);
          --major: var(--light-major);
          --letter: var(--light-letter);
          --needle: var(--light-needle);
          --gust: var(--light-gust);
          --range: var(--light-range);
          --swatch-edge: var(--light-swatch-edge);
          --rose1: var(--light-rose1);
          --rose2: var(--light-rose2);
          --rose3: var(--light-rose3);
          --rose4: var(--light-rose4);
          --rose5: var(--light-rose5);
          --rose6: var(--light-rose6);
          --backdrop: var(--light-backdrop);
        }
      }
      :root[data-theme="light"] {
        color-scheme: light;
        --ground: var(--light-ground);
        --card: var(--light-card);
        --line: var(--light-line);
        --ring: var(--light-ring);
        --ink: var(--light-ink);
        --ink-2: var(--light-ink-2);
        --muted: var(--light-muted);
        --heading: var(--light-heading);
        --hi: var(--light-hi);
        --lo: var(--light-lo);
        --live: var(--light-live);
        --face: var(--light-face);
        --rim: var(--light-rim);
        --tick: var(--light-tick);
        --major: var(--light-major);
        --letter: var(--light-letter);
        --needle: var(--light-needle);
        --gust: var(--light-gust);
        --range: var(--light-range);
        --swatch-edge: var(--light-swatch-edge);
        --rose1: var(--light-rose1);
        --rose2: var(--light-rose2);
        --rose3: var(--light-rose3);
        --rose4: var(--light-rose4);
        --rose5: var(--light-rose5);
        --rose6: var(--light-rose6);
        --backdrop: var(--light-backdrop);
      }
      html, body { background: var(--ground); }
      body {
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        margin: 0;
        padding: 24px 20px 40px;
        font-variant-numeric: tabular-nums;
      }
      .wrap { margin: 0 auto; }
      header {
        display: grid; grid-template-columns: 1fr auto 1fr;
        align-items: baseline; gap: 16px; margin-bottom: 30px;
      }
      h1 {
        font-size: 20px; font-weight: 600; letter-spacing: 0.01em;
        margin: 0; text-align: center;
      }
      .stamp { font-size: 12px; color: var(--muted); }
      .live {
        font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
        color: var(--live); text-align: right; cursor: default;
      }
      /* --cw is the width inside a card, which the fixed column count
         makes a function of the window: the window, less the body's
         padding and the gaps between columns, over the columns, less the
         card's padding and border.  The words under a dial are sized from
         it, so they grow with the card as the drawing above them does. */
      .gauges {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        --cw: calc((100vw - 88px) / 4 - 26px);
      }
      @media (max-width: 1080px) {
        .gauges { grid-template-columns: repeat(3, 1fr); --cw: calc((100vw - 72px) / 3 - 26px); }
      }
      @media (max-width: 800px) {
        .gauges { grid-template-columns: repeat(2, 1fr); --cw: calc((100vw - 56px) / 2 - 26px); }
      }
      @media (max-width: 540px) {
        .gauges { grid-template-columns: 1fr; --cw: calc(100vw - 66px); }
      }
      /* EACH INSTRUMENT IS A CARD. */
      .gauge {
        display: flex; flex-direction: column; min-width: 0;
        background: var(--card); border: 1px solid var(--line);
        padding: 14px 12px 12px; box-sizing: border-box;
      }
      .gauge h2 {
        margin: 0 0 6px; color: var(--heading); font-weight: 600;
        font-size: clamp(12px, calc(var(--cw) * 0.042), 16px);
        letter-spacing: 0.08em; text-transform: uppercase;
      }
      /* The drawing's square is held before the first poll fills it, so
         the page does not jump when it lands, and it stops at 480px.
         overflow visible: the windrose's letters sit at the edge of the
         drawing. */
      .draw { width: 100%; max-width: 480px; aspect-ratio: 1; margin: 0 auto; }
      .draw svg { display: block; width: 100%; height: auto; overflow: visible; }
      .draw text { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }

      /* The lines under a dial: the reading, what it means, today's high
         above its low. */
      .read { text-align: center; margin-top: 2px; }
      .reading { color: var(--muted); font-size: clamp(14px, calc(var(--cw) * 0.05), 20px); }
      .reading b { color: var(--ink); font-size: clamp(24px, calc(var(--cw) * 0.105), 46px); font-weight: 600; }
      .unit { white-space: pre; }
      .word { color: var(--ink-2); font-size: clamp(13px, calc(var(--cw) * 0.046), 18px); min-height: 1.4em; }
      .word b { color: var(--ink); }
      .range {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 14px;
        color: var(--muted); font-size: clamp(12px, calc(var(--cw) * 0.042), 16px);
        margin-top: 4px; min-height: 1.3em;
      }
      .hi { color: var(--hi); }
      .lo { color: var(--lo); }

      /* The drawing.  Sizes are in the drawing's own 200 units, so they
         scale with the card. */
      .draw .face { fill: var(--face); stroke: var(--rim); stroke-width: 1.5; }
      .draw .tick { stroke: var(--tick); stroke-width: 1.2; }
      .draw .tick.major { stroke: var(--major); stroke-width: 2.2; }
      .draw .num { fill: var(--ink-2); font-size: 13px; font-weight: 600; }
      .draw .rim { fill: none; stroke-width: 7; }
      .draw .span, .draw .trend { fill: none; stroke: var(--range); stroke-width: 4; stroke-linecap: round; }
      .draw .trend { stroke-linecap: butt; }
      .draw .trend-head { fill: var(--range); }
      .draw .needle { stroke: var(--needle); stroke-width: 3; stroke-linecap: round; }
      .draw .hub { fill: var(--needle); }
      .draw .gust { stroke: var(--gust); stroke-width: 2.5; stroke-linecap: round; }
      .draw .hub.still { fill: var(--gust); }
      .draw .letter { fill: var(--letter); font-size: 14px; font-weight: 600; }
      .draw .letter.north { fill: var(--major); font-weight: 700; }
      /* The windrose's reference rings and the hub's edge: at 3:1 on the
         face they sit on, quieter than the ticks so the petals lead. */
      .draw .ring { fill: none; stroke: var(--ring); stroke-width: 1; }
      .draw .petal { stroke: var(--face); stroke-width: 0.6; }
      .draw .hub-disc { fill: var(--face); stroke: var(--ring); stroke-width: 1.5; }
      .draw .hub-pct { fill: var(--ink); font-size: 12px; font-weight: 600; }
      .draw .hub-calm { fill: var(--muted); font-size: 12px; }
      /* The windrose's drawing is cropped 230.4 units wide rather than
         200, so its face matches the dials'.  Everything sized in drawing
         units -- its words AND its line widths -- is set 230.4/200 larger
         to come out on screen the size of the dials'; scaling only the
         words left its rim and rings 13% thinner than theirs. */
      .draw .rose .letter { font-size: 16.1px; }
      .draw .rose .hub-pct, .draw .rose .hub-calm { font-size: 13.8px; }
      .draw .rose .face { stroke-width: 1.73; }
      .draw .rose .ring { stroke-width: 1.15; }
      .draw .rose .hub-disc { stroke-width: 1.73; }
      .draw .rose .petal { stroke-width: 0.69; }

      /* The category rims: EPA's own colors, the same in both themes,
         for the UV Index and the Air Quality Index. */
      .draw .rim.uv-1 { stroke: #289500; }
      .draw .rim.uv-2 { stroke: #f7e400; }
      .draw .rim.uv-3 { stroke: #f85900; }
      .draw .rim.uv-4 { stroke: #d8001d; }
      .draw .rim.uv-5 { stroke: #6b49c8; }
      .draw .rim.aqi-1 { stroke: #00e400; }
      .draw .rim.aqi-2 { stroke: #ffff00; }
      .draw .rim.aqi-3 { stroke: #ff7e00; }
      .draw .rim.aqi-4 { stroke: #ff0000; }
      .draw .rim.aqi-5 { stroke: #8f3f97; }
      .draw .rim.aqi-6 { stroke: #7e0023; }

      .legend {
        display: flex; flex-wrap: wrap; gap: 4px 10px; justify-content: center;
        font-size: clamp(12px, calc(var(--cw) * 0.04), 15px); color: var(--ink); margin-top: 8px;
      }
      /* Until the first poll fills it -- and for ever on a report that
         declares no windrose group -- the legend is empty markup. */
      .legend:empty { display: none; }
      .legend span { display: flex; align-items: center; gap: 4px; }
      /* EVERY SWATCH CARRIES AN EDGE: the dark theme's windiest band is
         near-white by design, and a swatch that cannot be told from its
         card identifies nothing. */
      .legend i {
        width: 11px; height: 11px; display: inline-block; border-radius: 2px;
        border: 1px solid var(--swatch-edge); box-sizing: border-box;
      }

      /* THE GAUGE CARDS (8.0): a dialog over the panel, a full-screen
         sheet under 600px.  Every color is one of the tokens above, so a
         card wears whichever theme the page wears.  The dial inside a
         card is the panel's own markup, copied, and the .draw rules above
         dress it.  The words are sized in px, not from --cw: a card is as
         wide as the window allows, not as wide as a column. */
      .hint { text-align: center; color: var(--muted); font-size: 13px; margin: -18px 0 22px; }
      .hint .touch { display: none; }
      @media (hover: none) { .hint .mouse { display: none; } .hint .touch { display: inline; } }
      .gauge { cursor: pointer; }
      .gauge .draw:focus-visible { outline: 2px solid var(--live); outline-offset: 4px; border-radius: 50%; }
      html.card-open, html.card-open body { overflow: hidden; }
      dialog.card {
        box-sizing: border-box; overscroll-behavior: contain;
        width: min(52rem, calc(100vw - 2rem)); max-height: calc(100vh - 2rem);
        padding: 0; border: 1px solid var(--line); border-radius: 10px;
        background: var(--card); color: var(--ink); overflow: auto;
        font-variant-numeric: tabular-nums;
      }
      dialog.card::backdrop { background: var(--backdrop); }
      dialog.card:focus, .card-head h2:focus { outline: none; }
      .card-head {
        position: sticky; top: 0; z-index: 2;
        display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 12px;
        padding: 12px 16px 10px; background: var(--card); border-bottom: 1px solid var(--line);
      }
      .card-head h2 { margin: 0; color: var(--heading); font-weight: 600; font-size: 22px; letter-spacing: 0.01em; }
      .card-head .sub { margin: 2px 0 0; font-size: 12px; color: var(--muted); display: flex; gap: 10px; align-items: center; }
      .card-head .pill { font-weight: 600; letter-spacing: 0.14em; color: var(--live); }
      .card-nav { display: flex; gap: 6px; }
      .card-nav button {
        font: inherit; font-size: 20px; line-height: 1; width: 40px; height: 34px;
        border: 1px solid var(--line); background: var(--face); color: var(--ink); border-radius: 6px; cursor: pointer;
      }
      .card-nav button:hover { border-color: var(--ring); }
      .card-body { padding: 16px 20px 22px; }
      .now { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 20px; align-items: start; }
      .now .draw { max-width: 200px; }
      .now .read { font-size: 14px; }
      .now .reading b { font-size: 30px; }
      .now .word { font-size: 14px; }
      .now .range { font-size: 13px; }
      .now .legend { font-size: 12px; }
      .say p { margin: 0 0 6px; color: var(--ink-2); font-size: 15px; line-height: 1.45; }
      .say p.lead { color: var(--ink); font-size: 19px; font-weight: 600; line-height: 1.3; margin-bottom: 8px; }
      .say p.fine { color: var(--muted); font-size: 13px; }
      .say b { color: var(--ink); }
      .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; }
      .facts div { border: 1px solid var(--line); background: var(--face); border-radius: 8px; padding: 8px 10px; min-width: 0; }
      .facts .fl { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
      .facts b { font-size: 20px; color: var(--ink); overflow-wrap: anywhere; }
      .facts .fs { display: block; font-size: 12px; color: var(--muted); }
      .sec { margin-top: 20px; }
      .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 8px; }
      .sec h3 { margin: 0; color: var(--heading); font-weight: 600; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
      .sec .aside { color: var(--muted); font-size: 12px; text-align: right; }
      .sec p { margin: 8px 0 0; color: var(--muted); font-size: 13px; line-height: 1.45; }
      /* The ladder: one row per period, a bar from the period's low to its
         high on a shared axis, the reading now as a line through every
         row.  A single-ended ladder runs every bar from zero.  The bars
         take --range, the arc's color; UV and air quality bars take
         EPA's category colors through the rim classes above. */
      .ladder { display: grid; grid-template-columns: max-content max-content minmax(0, 1fr) max-content; gap: 6px 10px; align-items: center; font-size: 13px; }
      .ladder.single { grid-template-columns: max-content minmax(0, 1fr) max-content; }
      .ladder .lab { color: var(--ink-2); white-space: nowrap; }
      .ladder .end { white-space: nowrap; line-height: 1.15; }
      .ladder .end small { display: block; color: var(--muted); font-size: 11px; }
      .ladder .end.lo { text-align: right; color: var(--lo); }
      .ladder .end.hi { color: var(--hi); }
      .ladder .end.hi.plain { color: var(--ink); }
      .ladder .track { position: relative; height: 14px; background: var(--face); border: 1px solid var(--line); border-radius: 3px; }
      .ladder .bar { position: absolute; top: 2px; bottom: 2px; background: var(--range); border-radius: 2px; min-width: 2px; }
      .ladder .bar.uv-1, .scale i.uv-1 { background: #289500; }
      .ladder .bar.uv-2, .scale i.uv-2 { background: #f7e400; }
      .ladder .bar.uv-3, .scale i.uv-3 { background: #f85900; }
      .ladder .bar.uv-4, .scale i.uv-4 { background: #d8001d; }
      .ladder .bar.uv-5, .scale i.uv-5 { background: #6b49c8; }
      .ladder .bar.aqi-1, .scale i.aqi-1 { background: #00e400; }
      .ladder .bar.aqi-2, .scale i.aqi-2 { background: #ffff00; }
      .ladder .bar.aqi-3, .scale i.aqi-3 { background: #ff7e00; }
      .ladder .bar.aqi-4, .scale i.aqi-4 { background: #ff0000; }
      .ladder .bar.aqi-5, .scale i.aqi-5 { background: #8f3f97; }
      .ladder .bar.aqi-6, .scale i.aqi-6 { background: #7e0023; }
      .ladder .mark { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background: var(--needle); }
      .ladder .axis { grid-column: 3; display: flex; justify-content: space-between; color: var(--muted); font-size: 11px; }
      .ladder.single .axis { grid-column: 2; }
      .ladder .none { grid-column: 3 / span 2; color: var(--muted); font-style: italic; }
      .ladder.single .none { grid-column: 2 / span 2; }
      .key { color: var(--muted); font-size: 12px; margin-top: 6px; }
      .key i { display: inline-block; width: 2px; height: 11px; background: var(--needle); vertical-align: -1px; margin: 0 6px 0 2px; }
      .key i.bar { width: 18px; height: 8px; background: var(--range); border-radius: 2px; }
      /* The roses by period, and a category scale with the reading's row marked. */
      .roses { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
      .roses figure { margin: 0; text-align: center; }
      .roses .draw { max-width: 150px; margin: 0 auto; }
      .roses figcaption { font-size: 12px; color: var(--ink-2); margin-top: 4px; }
      .scale { border-collapse: collapse; font-size: 13px; width: 100%; }
      .scale td { padding: 3px 8px 3px 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
      .scale td:first-child { width: 14px; padding-right: 4px; }
      .scale i { display: inline-block; width: 12px; height: 12px; border-radius: 2px; border: 1px solid var(--swatch-edge); box-sizing: border-box; vertical-align: -1px; }
      .scale tr.on td { color: var(--ink); font-weight: 600; background: var(--face); }
      .scale td.n { text-align: right; white-space: nowrap; color: var(--muted); }
      @media (max-width: 600px) {
        dialog.card { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border: 0; border-radius: 0; margin: 0; }
        .card-nav button { width: 44px; height: 44px; }
        .card-body { padding: 14px 14px 24px; }
        .now { grid-template-columns: 1fr; }
        .now .draw { max-width: 190px; margin: 0 auto; }
        .facts { grid-template-columns: 1fr 1fr; }
        .roses { grid-template-columns: repeat(3, 1fr); }
        .ladder { font-size: 12px; gap: 6px 6px; }
      }
    </style>
  </head>
  <body>
    #include "analytics.inc"
    #include "realtime_updater.inc"
    #include "gauge_cards.inc"
    <div class="wrap">
      <header>
        <span class="stamp" id="last-update"></span>
        <h1>
          #if $Extras.has_key('title')
            $Extras.title
          #else
            $station.location
          #end if
        </h1>
        <span class="live" id="live-label"></span>
      </header>
      <p class="hint"><span class="mouse">$gettext('Click any gauge for more.')</span><span class="touch">$gettext('Tap any gauge for more.')</span></p>
      <div class="gauges">
        <div class="gauge">
          <h2>$gettext("Today's Windrose")</h2>
          <div class="draw" id="gauge-rose"></div>
          <div class="legend" id="rose-legend"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Wind")</h2>
          <div class="draw" id="gauge-wind"></div>
          <div class="read" id="read-wind"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Temperature")</h2>
          <div class="draw" id="gauge-temp"></div>
          <div class="read" id="read-temp"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Dew Point")</h2>
          <div class="draw" id="gauge-dew"></div>
          <div class="read" id="read-dew"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Humidity")</h2>
          <div class="draw" id="gauge-hum"></div>
          <div class="read" id="read-hum"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Barometer")</h2>
          <div class="draw" id="gauge-baro"></div>
          <div class="read" id="read-baro"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Rain")</h2>
          <div class="draw" id="gauge-rain"></div>
          <div class="read" id="read-rain"></div>
        </div>
        <div class="gauge">
          <h2>$gettext("Rain Rate")</h2>
          <div class="draw" id="gauge-rrate"></div>
          <div class="read" id="read-rrate"></div>
        </div>
        <div class="gauge" id="cell-feel">
          <h2>$gettext("Feels Like")</h2>
          <div class="draw" id="gauge-feel"></div>
          <div class="read" id="read-feel"></div>
        </div>
        <div class="gauge" id="cell-uv">
          <h2>$gettext("UV Index")</h2>
          <div class="draw" id="gauge-uv"></div>
          <div class="read" id="read-uv"></div>
        </div>
        <div class="gauge" id="cell-rad">
          <h2>$gettext("Solar Radiation")</h2>
          <div class="draw" id="gauge-rad"></div>
          <div class="read" id="read-rad"></div>
        </div>
        <div class="gauge" id="cell-aqi">
          <h2>$gettext("Air Quality")</h2>
          <div class="draw" id="gauge-aqi"></div>
          <div class="read" id="read-aqi"></div>
        </div>
      </div>
    </div>
  </body>
</html>
